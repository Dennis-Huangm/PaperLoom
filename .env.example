# OpenAI, compatible provider, or local Ollama OpenAI-compatible endpoint.
LLM_API_KEY=
LLM_BASE_URL=

# Optional metadata API keys. Public endpoints work at lower rate limits.
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
ALPHAXIV_API_KEY=
ZOTERO_LOCAL_API_KEY=

# Optional OpenReview login for conference directories that require an account.
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# Optional SMTP delivery.
QQ_EMAIL=
SMTP_PASSWORD=

# Optional PDF-only direct curl transport; API and LLM keep their proxy settings.
# Windows: prefers the system curl.exe. Default: httpx.
ARXIV_PDF_BACKEND=httpx
